{
  "rollout_engine": "native-pytorch",
  "max_steps": 100,
  "group_size": 4,
  "groups_per_step": 1,
  "max_new_tokens": 512,
  "max_prompt_tokens": 8192,
  "length_policy": "error",
  "temperature": 1.0,
  "learning_rate": 0.000001,
  "kl_beta": 0.02,
  "reward": "numeric_answer",
  "truncated_reward": 0.0,
  "max_policy_lag": 2,
  "queue_capacity": 2,
  "eval_interval": 10,
  "eval_samples_per_prompt": 1,
  "eval_seed": 1234,
  "checkpoint_interval": 1,
  "log_samples_per_step": 2,
  "trainer_num_gpus": 1,
  "rollout_num_gpus": 1,
  "engram_offload": true,
  "dtype": "bfloat16",
  "output_dir": "runs/dsv41_text"
}
